# Copy to .env and fill secrets. Never commit .env.

PORT=4000
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-string

# Prisma / MySQL (matches docker-compose)
DATABASE_URL="mysql://root:root@localhost:3307/ong_mail"

REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200

# Phase 2+
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:4000/auth/slack/callback

WORKER_CONCURRENCY=4
MIN_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=60
